local SpeedInput = createInput(PageMain, "ความเร็ว WalkSpeed (1 - 2000)...")
SpeedInput.Text = tostring(SavedSettings.WalkSpeed or 16)

local JumpInput = createInput(PageMain, "แรงกระโดด JumpPower (1 - 2000)...")
JumpInput.Text = tostring(SavedSettings.JumpPower or 50)

createButton(PageMain, "⚡ ยืนยันปรับความเร็ว & แรงกระโดด", function()
    local speedVal = math.clamp(tonumber(SpeedInput.Text) or 16, 1, 2000)
    local jumpVal = math.clamp(tonumber(JumpInput.Text) or 50, 1, 2000)
    
    SpeedInput.Text = tostring(speedVal)
    JumpInput.Text = tostring(jumpVal)
    SavedSettings.WalkSpeed = speedVal
    SavedSettings.JumpPower = jumpVal
    
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        hum.WalkSpeed = speedVal
        hum.UseJumpPower = true
        hum.JumpPower = jumpVal
    end
end)

local NoclipBtn = createButton(PageMain, "👻 เปิด / ปิด Noclip (เดินทะลุ)", function()
