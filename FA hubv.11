-- [ FIXED TAB SYSTEM ]
---------------------------------------------------------
local TabBar = Instance.new("ScrollingFrame", MainFrame)
TabBar.Size = UDim2.new(1, -20, 0, 35)
TabBar.Position = UDim2.new(0, 10, 0, 38)
TabBar.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
TabBar.BackgroundTransparency = 0.5
TabBar.ScrollBarThickness = 2
TabBar.CanvasSize = UDim2.new(0, 480, 0, 0) -- ขยายความกว้างแท็บให้เลื่อนง่าย
Instance.new("UICorner", TabBar).CornerRadius = UDim.new(0, 6)

local TabBarLayout = Instance.new("UIListLayout", TabBar)
TabBarLayout.FillDirection = Enum.FillDirection.Horizontal
TabBarLayout.SortOrder = Enum.SortOrder.LayoutOrder
TabBarLayout.Padding = UDim.new(0, 5)

local ContentContainer = Instance.new("Frame", MainFrame)
ContentContainer.Size = UDim2.new(1, -20, 1, -85)
ContentContainer.Position = UDim2.new(0, 10, 0, 80)
ContentContainer.BackgroundTransparency = 1

local Pages = {}

local function createPage()
    local page = Instance.new("ScrollingFrame", ContentContainer)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 4
    page.Visible = false
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y -- ปรับความยาวหน้าอัตโนมัติ แก้บั๊กลอย
    
    local layout = Instance.new("UIListLayout", page)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6) -- เรียงปุ่มแนวตั้งอัตโนมัติ
    
    return page
end

local PageMain     = createPage()
local PageCombat   = createPage()
local PageVisual   = createPage()
local PageMusic    = createPage()
local PageSettings = createPage()
PageMain.Visible = true

local function createTabBtn(text, page)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size = UDim2.new(0, 90, 1, 0)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    btn.BackgroundTransparency = 0.2
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        PageMain.Visible = false; PageCombat.Visible = false; PageVisual.Visible = false; PageMusic.Visible = false; PageSettings.Visible = false
        page.Visible = true
    end)
    return btn
end

createTabBtn("หลัก (Main)", PageMain)
createTabBtn("🎯 ต่อสู้", PageCombat)
createTabBtn("👁️ มองเห็น", PageVisual)
createTabBtn("🎵 เพลง", PageMusic)
createTabBtn("⚙️ ตั้งค่า", PageSettings)

-- Component Helpers (ใช้อัตโนมัติร่วมกับ UIListLayout)
local function createButton(parent, text, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -8, 0, 32)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    btn.BackgroundTransparency = 0.3
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local function createInput(parent, placeholder)
    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(1, -8, 0, 32)
    box.PlaceholderText = placeholder
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
    box.BackgroundTransparency = 0.3
    box.Font = Enum.Font.SourceSans
    box.TextSize = 13
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    return box
end

