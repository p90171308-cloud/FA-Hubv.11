local function updateTheme(r, g, b)
    local newColor = Color3.fromRGB(r, g, b)
    SavedSettings.ThemeColor = {r, g, b}
    ToggleBtn.TextColor3 = newColor
    ToggleUIStroke.Color = newColor
    if FOVCircle then FOVCircle.Color = newColor end
end

createButton(PageSettings, "🟢 ธีมสีเขียว (Emerald Green)", function() updateTheme(0, 255, 150) end)
createButton(PageSettings, "🔵 ธีมสีฟ้า (Neon Blue)", function() updateTheme(0, 180, 255) end)
createButton(PageSettings, "🔴 ธีมสีแดง (Ruby Red)", function() updateTheme(255, 50, 50) end)
createButton(PageSettings, "🟣 ธีมสีม่วง (Purple Cyber)", function() updateTheme(180, 50, 255) end)
createButton(PageSettings, "🟡 ธีมสีทอง (Gold Deluxe)", function() updateTheme(255, 215, 0) end)

createButton(PageSettings, "💾 บันทึกการตั้งค่าทั้งหมด (Save Data)", function()
    saveSettings()
    print("[FA Hub] เซฟเรียบร้อย!")
end)

-- Auto Apply เมื่อเกิดใหม่
LocalPlayer.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        if SavedSettings.WalkSpeed then hum.WalkSpeed = math.clamp(SavedSettings.WalkSpeed, 1, 2000) end
        if SavedSettings.JumpPower then hum.UseJumpPower = true hum.JumpPower = math.clamp(SavedSettings.JumpPower, 1, 2000) end
    end
end)

